{
  "manifest_version": 3,
  "name": "Creator Card Porter",
  "version": "0.5.2",
  "description": "Capture creator-owned character data and export a portable form-source JSON file.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Creator Card Porter",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
