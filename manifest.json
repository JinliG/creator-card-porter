{
  "manifest_version": 3,
  "name": "Creator Card Porter",
  "version": "0.2.2",
  "description": "Capture creator-owned character data and export a the target platform form-source JSON file.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "clipboardWrite", "scripting", "storage"],
  "host_permissions": [
    "https://janitorai.com/*",
    "https://www.janitorai.com/*",
    "https://jannyai.com/*",
    "https://www.jannyai.com/*"
  ],
  "action": {
    "default_title": "Creator Card Porter",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://janitorai.com/*",
        "https://www.janitorai.com/*",
        "https://jannyai.com/*",
        "https://www.jannyai.com/*"
      ],
      "js": ["capture/page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://janitorai.com/*",
        "https://www.janitorai.com/*",
        "https://jannyai.com/*",
        "https://www.jannyai.com/*"
      ],
      "js": ["capture/content.js"],
      "run_at": "document_start"
    }
  ]
}
